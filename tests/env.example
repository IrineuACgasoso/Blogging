# Configuração dos testes "live" (os que atacam o site e o Supabase de verdade).
# Copie este arquivo para tests/.env.test e preencha. NUNCA suba o .env.test para o GitHub (já está no .gitignore).
# Testes sem a variável necessária aparecem como SKIP (pulado), não como erro.

# Endereço do site publicado, sem barra no final.
SITE_URL=https://SEU-SITE.vercel.app

# Supabase > Project Settings > API  (a chave "anon" é pública; NUNCA coloque a service_role aqui)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# Token de uma conta de LEITORA comum (não admin). Veja o passo a passo no tests/README.md. Dura ~1 hora.
READER_JWT=

# Para testar o cron de verdade: o mesmo CRON_SECRET da Vercel + ligue o interruptor.
# Atenção: isso EXECUTA a virada do dia (a mesma coisa que o cron faz à meia-noite). Deixe vazio para pular.
CRON_SECRET=
LIVE_RUN_CRON=
